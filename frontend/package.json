{
  "name": "contract-review-frontend",
  "version": "1.0.0",
  "description": "中小企业智能合同审查平台前端",
  "type": "module",
  "scripts": {
    "dev": "cross-env SASS_DEPRECATION_WARNINGS=0 vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.6.0",
    "dayjs": "^1.11.0",
    "echarts": "^5.4.0",
    "element-plus": "^2.4.0",
    "file-saver": "^2.0.0",
    "js-cookie": "^3.0.0",
    "lodash-es": "^4.17.0",
    "mammoth": "^1.6.0",
    "pdfjs-dist": "^2.16.105",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-echarts": "^6.6.0",
    "vue-i18n": "^9.0.0",
    "vue-router": "^4.2.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/tsconfig": "^0.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.97.3",
    "typescript": "~5.2.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0"
  },
  "author": "Contract Review Team",
  "license": "MIT"
}
