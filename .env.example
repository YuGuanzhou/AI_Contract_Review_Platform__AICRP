# 中小企业智能合同审查平台环境配置
# 复制此文件为 .env 并修改相应配置

# ============ 应用配置 ============
APP_NAME=中小企业智能合同审查平台
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ============ 数据库配置 ============
# 使用 MySQL（根据项目配置）
DATABASE_URL=mysql://root:password@localhost:3306/contract_db
# 或者使用 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/contract_db

# ============ Redis配置 ============
# Redis默认密码：12345678
REDIS_URL=redis://:12345678@localhost:6379/0

# ============ MinIO配置 ============
# MinIO默认账号：root，密码：12345678
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=12345678
MINIO_SECURE=false
MINIO_BUCKET_NAME=contracts

# ============ JWT配置 ============
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ AI配置 ============
# AI服务提供商: deepseek, openai, local
AI_PROVIDER=deepseek

# DeepSeek配置（请填写你自己的密钥，勿提交真实密钥）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com

# OpenAI配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1

# ============ 文件上传配置 ============
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# ============ 邮件配置 ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@contract-review.com

# ============ 任务队列配置 ============
# Celery使用Redis，密码：12345678
CELERY_BROKER_URL=redis://:12345678@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:12345678@localhost:6379/2

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============ 前端配置 ============
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=智能合同审查平台